# RDMA Cluster Configuration
# Copy to cluster.toml and fill in your CloudLab experiment details.
# cluster.toml is gitignored — edit it each time you get new machines.

[experiment]
user = "lucas"
ssh_key = "~/.ssh/cloudlab"
remote_dir = "/local/rdma"
ib_interface = "ibp8s0"
ib_netmask = "255.255.255.0"
ib_mtu = 65520

# Servers: node_name = "ssh_hostname  ib_ip"
# Node ID is determined by order (node0 = 0, node1 = 1, ...)
[servers]
node0 = "node0.utah.cloudlab.us  192.168.1.1"
node1 = "node1.utah.cloudlab.us  192.168.1.2"
node2 = "node2.utah.cloudlab.us  192.168.1.3"
node3 = "node3.utah.cloudlab.us  192.168.1.4"
node4 = "node4.utah.cloudlab.us  192.168.1.5"

# Clients: client_name = "ssh_hostname  ib_ip"
# Machine ID is determined by order (client0 = 0, client1 = 1, ...)
[clients]
client0 = "node5.utah.cloudlab.us  192.168.1.6"
